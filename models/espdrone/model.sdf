<sdf version="1.9">
  <model name="espdrone">
    <link name="body">
      <pose>0 0 0.0225 0 0 0</pose>
      <!-- sujeto a gz-sim-wind-effects-system cuando el mundo declara <wind>
           (no-op en mundos sin ese plugin) -->
      <enable_wind>true</enable_wind>
      <inertial>
        <mass>0.059</mass>
        <inertia>
          <ixx>1.5940e-05</ixx><ixy>1.80e-08</ixy><iyy>1.4535e-05</iyy>
          <ixz>4.33e-08</ixz><iyz>3.34e-07</iyz><izz>2.8468e-05</izz>
        </inertia>
      </inertial>

      <collision name="body_collision">
        <geometry>
          <box><size>0.104 0.104 0.045</size></box>
        </geometry>
        <surface>
          <bounce>
            <restitution_coefficient>0.828</restitution_coefficient>
            <threshold>0</threshold>
          </bounce>
          <friction>
            <ode><mu>1.0</mu><mu2>0.8</mu2></ode>
          </friction>
          <contact>
            <ode>
              <kp>10000.0</kp><kd>10.0</kd>
              <max_vel>0.01</max_vel><min_depth>0</min_depth>
            </ode>
          </contact>
        </surface>
      </collision>

      <visual name="body_visual">
        <pose>0.0225 -0.0225 0 0 -1.570796 1.570796</pose>
        <geometry>
          <mesh><uri>model://espdrone/meshes/espdrone.dae</uri></mesh>
        </geometry>
      </visual>
    </link>

    <!-- Propeller: rear-right (CCW) — firmware M2 -->
    <link name="propeller_rr">
      <pose>-0.04175 -0.04175 0.037 0 0 0</pose>
      <inertial>
        <mass>0.001</mass>
        <inertia><ixx>1.0e-08</ixx><iyy>1.3e-07</iyy><izz>1.4e-07</izz></inertia>
      </inertial>
    </link>
    <joint name="propeller_rr_joint" type="revolute">
      <child>propeller_rr</child><parent>body</parent>
      <axis><xyz>0 0 1</xyz></axis>
    </joint>

    <!-- Propeller: rear-left (CW) — firmware M3 -->
    <link name="propeller_rl">
      <pose>-0.04175 0.04175 0.037 0 0 0</pose>
      <inertial>
        <mass>0.001</mass>
        <inertia><ixx>1.0e-08</ixx><iyy>1.3e-07</iyy><izz>1.4e-07</izz></inertia>
      </inertial>
    </link>
    <joint name="propeller_rl_joint" type="revolute">
      <child>propeller_rl</child><parent>body</parent>
      <axis><xyz>0 0 1</xyz></axis>
    </joint>

    <!-- Propeller: front-right (CW) — firmware M1 -->
    <link name="propeller_fr">
      <pose>0.04175 -0.04175 0.037 0 0 0</pose>
      <inertial>
        <mass>0.001</mass>
        <inertia><ixx>1.0e-08</ixx><iyy>1.3e-07</iyy><izz>1.4e-07</izz></inertia>
      </inertial>
    </link>
    <joint name="propeller_fr_joint" type="revolute">
      <child>propeller_fr</child><parent>body</parent>
      <axis><xyz>0 0 1</xyz></axis>
    </joint>

    <!-- Propeller: front-left (CCW) — firmware M4 -->
    <link name="propeller_fl">
      <pose>0.04175 0.04175 0.037 0 0 0</pose>
      <inertial>
        <mass>0.001</mass>
        <inertia><ixx>1.0e-08</ixx><iyy>1.3e-07</iyy><izz>1.4e-07</izz></inertia>
      </inertial>
    </link>
    <joint name="propeller_fl_joint" type="revolute">
      <child>propeller_fl</child><parent>body</parent>
      <axis><xyz>0 0 1</xyz></axis>
    </joint>
  </model>
</sdf>
